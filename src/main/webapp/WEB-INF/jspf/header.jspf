<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KrishvaMart</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <script>
        if (localStorage.getItem("krishvamart-theme") === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
        }
    </script>
    <script src="${pageContext.request.contextPath}/js/floating-dots.js" defer></script>
</head>
<body>
    <div id="introOverlay" class="intro-overlay">
        <div class="intro-stage">
            <div class="intro-logo-container">
                <svg viewBox="0 0 100 100" class="intro-k-svg" fill="#ffffff" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 15 H32 V85 H20 Z" />
                    <path d="M36 15 H39 V85 H36 Z" />
                    <polygon points="39,52 68,15 86,15 48,58" />
                    <polygon points="42,50 86,85 68,85 39,55" />
                </svg>
                <div class="intro-brand-text">KRISHVAMART</div>
            </div>
            <div class="slogan-type">You're Quality is our First Priority</div>
        </div>
    </div>

    <header class="site-header">
        <a class="brand brand-k" href="${pageContext.request.contextPath}/jsp/index.jsp" title="KrishvaMart">
            <svg viewBox="0 0 100 100" class="k-logo-svg" fill="#ffffff" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 15 H32 V85 H20 Z" />
                <path d="M36 15 H39 V85 H36 Z" />
                <polygon points="39,52 68,15 86,15 48,58" />
                <polygon points="42,50 86,85 68,85 39,55" />
            </svg>
        </a>
        
        <nav id="siteNav">
            <a href="${pageContext.request.contextPath}/jsp/index.jsp">Browse</a>
            <a href="${pageContext.request.contextPath}/jsp/cart.jsp">Cart</a>
            <a href="${pageContext.request.contextPath}/jsp/wishlist.jsp">Wishlist</a>
            <a href="${pageContext.request.contextPath}/jsp/orders.jsp">Orders</a>
            <a href="${pageContext.request.contextPath}/jsp/seller-dashboard.jsp">Sell</a>
            <a href="${pageContext.request.contextPath}/jsp/admin.jsp">Admin</a>
            <div class="nav-indicator" id="navIndicator"></div>
        </nav>

        <div class="session-box" id="sessionBox">
            <button id="themeToggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">&#9788;</button>
            <c:choose>
                <c:when test="${not empty sessionScope.authUser}">
                    <span class="user-display"><c:out value="${sessionScope.authUser.name}"/></span>
                    <button id="logoutBtn">Log out</button>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/jsp/login.jsp">Log in</a>
                    <a href="${pageContext.request.contextPath}/jsp/register.jsp">Register</a>
                </c:otherwise>
            </c:choose>
        </div>
    </header>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const overlay = document.getElementById("introOverlay");

        function dismissIntro() {
            if (!overlay) return;
            overlay.style.display = "none";
            sessionStorage.setItem("krishvamart_intro_viewed", "true");
        }

        if (sessionStorage.getItem("krishvamart_intro_viewed") === "true") {
            if (overlay) overlay.style.display = "none";
        } else {
            setTimeout(dismissIntro, 4800);
        }

        const nav = document.getElementById("siteNav");
        const indicator = document.getElementById("navIndicator");
        const navLinks = nav.querySelectorAll("a");

        function moveIndicatorTo(elem) {
            if (!elem || !indicator) return;
            indicator.style.width = elem.offsetWidth + "px";
            indicator.style.left = elem.offsetLeft + "px";
        }

        let activeLink = null;
        const currentPath = window.location.pathname;
        navLinks.forEach(link => {
            const href = link.getAttribute("href").split("/").pop();
            if (href && currentPath.includes(href)) {
                activeLink = link;
                link.classList.add("active");
            }
        });

        if (activeLink) moveIndicatorTo(activeLink);

        navLinks.forEach(link => {
            link.addEventListener("mouseenter", () => moveIndicatorTo(link));
            link.addEventListener("touchstart", () => moveIndicatorTo(link), { passive: true });
        });

        nav.addEventListener("mouseleave", () => moveIndicatorTo(activeLink));
        window.addEventListener("resize", () => moveIndicatorTo(activeLink));
    });
    </script>
    <main class="site-main">