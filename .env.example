# Copy this file to .env for reference when setting environment variables on
# your deployment platform (systemd EnvironmentFile, Docker --env-file, PaaS
# config UI, etc). This project reads its config from
# src/main/resources/config.properties at build/run time; the entries below
# document what backs each property so you can set them as environment
# variables on the actual deployment host as well.

# --- Database (backs db.* in config.properties) ---
DB_URL=jdbc:h2:tcp://localhost:9092/./data/krishvamart
DB_USER=sa
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- AI chatbot (Section 11 / 17; backs ai.chatbot.* in config.properties) ---
AI_CHATBOT_PROVIDER=mock
AI_CHATBOT_API_KEY=
