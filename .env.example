# Copy this file to .env for local reference, or set these directly in your
# cloud platform's "Environment Variables" screen (Render, Railway, Fly.io,
# AWS, etc). ConfigResolver reads env vars FIRST, falling back to
# config.properties, falling back to a hardcoded default - so the same WAR
# or Docker image works unmodified across environments (Section 18, item 3).
#
# Naming: each key here is the matching config.properties key, upper-cased
# with dots replaced by underscores (db.url -> DB_URL).

# --- Database ---
DB_URL=jdbc:h2:tcp://localhost:9092/./data/krishvamart
DB_USER=sa
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- AI chatbot (Section 11 / 17) ---
AI_CHATBOT_PROVIDER=mock
AI_CHATBOT_API_KEY=

# --- Self-initialization (SchemaInitializer) ---
# Applies db/schema.sql and seeds demo data on first boot against an empty
# database - what makes a fresh cloud deployment usable without SSH access.
# Set to false against a database you manage migrations for separately.
AUTO_INIT_SCHEMA=true
